# Codex CLI uses its normal login; run `codex login` first.
CHANGELOG_AGENT_PROVIDER=codex
CHANGELOG_AGENT_MODEL=gpt-6.1-sol
CHANGELOG_ANNOTATION_MODEL=gpt-6-luna
CHANGELOG_CODEX_REASONING_EFFORT=medium
CHANGELOG_CODEX_ANNOTATION_REASONING_EFFORT=low
# Use an absolute path if the scheduler's PATH selects a different CLI.
CHANGELOG_CODEX_BIN=codex
# Enable per run with --annotate, or here for scheduled runs too.
CHANGELOG_ANNOTATE=false
