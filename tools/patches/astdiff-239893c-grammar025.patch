+#[test]
+fn resource_bindings_normalize_renames_but_preserve_disposal_and_initializer_changes() {
+    let old = "function read(){using resource=open();return resource.value}";
+    let renamed = "function read(){using renamed=open();return renamed.value}";
+    assert!(compare(old, renamed).identical);
+    for new in [
+        "function read(){const resource=open();return resource.value}",
+        "function read(){using resource=openOther();return resource.value}",
+    ] {
+        assert!(!compare(old, new).identical);
+    }
+    assert!(!compare("using resource=open();", "using resource=openOther();").identical);
+}
