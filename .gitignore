# Claude Code archive data
# Only commit changelogs, changes, and prompts to git

# Ignore original downloaded files (multi-GB)
**/original/

# Ignore prettified files (multi-GB)
**/pretty/

# Ignore diff files (hundreds of MB)
**/diff/

# Ignore auto-filtered changes files
**/changes/

# Vendored reference material (extension dumps, etc.)
refs/

# Temp directory for sync tool
.sync-temp/
.sync-temp-*/
archive/*/.github-release-cache.json
archive/*/.github-release-cache.tmp
archive/*/.delivery/
archive/*/changelog/.drafts/

# Dedicated cwd for SDK agent runs (keeps their sessions out of the
# personal session bucket; never holds real content)
.agent-cwd/

# Bounded local agent transcripts (prompts, tool calls, outputs, errors)
.agent-logs/

# Environment variables
.env

# Local configuration (contains secrets)
tools/config.py

# Discord posting tracking
.last_posted_version
.last_posted_version_*
.upload_state.json
.upload_state_*.json
.upload_state*.tmp
.post_history.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Node modules
node_modules/

# Emacs backup files
*~
\#*\#
.\#*

# OS files
.DS_Store
Thumbs.db

# Temporary analysis outputs
dry-run
